{
  "name": "ai-privacy-guard",
  "description": "Local-first protection against sensitive data leaks in public AI tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "adm-zip": "^0.6.0",
      "brace-expansion": "^5.0.8",
      "esbuild": "^0.28.1",
      "shell-quote": "^1.10.0"
    }
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "api": "tsx apps/api/src/server.ts",
    "api:dev": "tsx watch apps/api/src/server.ts",
    "api:bundle": "esbuild apps/api/src/vercel-handler.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js && cp apps/api/src/db/schema.sql api/schema.sql",
    "stack": "pnpm build && pnpm api",
    "e2e": "pnpm build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "zip": "wxt zip",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@neondatabase/serverless": "^1.1.0",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.2"
  }
}
